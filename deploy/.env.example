# Copy to .env before first run:
#   cp .env.example .env

# --- ClickHouse ---
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-to-a-strong-password

# Where ClickHouse listens on the host.
# For abctl on the same VPS (Linux): use 0.0.0.0 and block 8123 in the firewall.
CLICKHOUSE_HOST_BIND=0.0.0.0

# Hostname/IP for Airbyte destination UI (kind pods → host ClickHouse).
# Linux default docker bridge gateway; on Docker Desktop use host.docker.internal.
AIRBYTE_CLICKHOUSE_HOST=172.17.0.1

# --- Dashboard ---
APP_PORT=8080
APP_HOST_BIND=127.0.0.1

# Auto-refresh marts from ClickHouse (every N minutes)
AUTO_REFRESH_ENABLED=true
MART_REFRESH_INTERVAL_MINUTES=15

# Optional: trigger Airbyte syncs via API (UUIDs from Airbyte → Connections)
AIRBYTE_SYNC_ENABLED=false
AIRBYTE_SYNC_INTERVAL_MINUTES=15
AIRBYTE_API_URL=http://127.0.0.1:8000
AIRBYTE_USERNAME=
AIRBYTE_PASSWORD=
AIRBYTE_CONNECTION_IDS=

# Google OAuth (dashboard login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
OAUTH_REDIRECT_URI=https://analytics.example.com/auth/callback
ALLOWED_EMAILS=anrewwolf68@gmail.com,danzobond@gmail.com

# --- Airbyte (abctl) ---
AIRBYTE_HOST=analytics.example.com
AIRBYTE_PORT=8000
# Set to 1 when serving Airbyte over plain HTTP (not recommended for production).
AIRBYTE_INSECURE_COOKIES=0
AIRBYTE_KIND_CLUSTER=airbyte-abctl
AIRBYTE_WORKSPACE_ID=3f56ead9-e8a3-496d-a96d-98fd18e7d52c

# --- Custom connectors ---
TIKTOK_CONNECTOR_TAG=dev

# VK source (one-time login: python3 scripts/vk-oauth-login.py --paste)
VK_APP_ID=
VK_REDIRECT_URI=https://content.netvolk.online/vk-oauth-callback
VK_OWNER_ID=-236233101

# Commenting as the owned accounts (dashboard video popup)
# YouTube needs a refresh token with youtube.force-ssl:
#   python3 scripts/youtube-oauth-login.py --paste
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
VK_ACCESS_TOKEN=
VK_COMMENT_FROM_GROUP=true
DZEN_SESSION_ID=
DZEN_CSRF_TOKEN=
