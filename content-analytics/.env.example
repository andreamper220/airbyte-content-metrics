# Copy to .env and set a strong password before: docker compose up -d --build
#
# cp .env.example .env

CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-to-a-strong-password

# Dashboard bind port on the host (nginx proxies to 127.0.0.1:APP_PORT)
APP_PORT=8080

# Auto-refresh marts from ClickHouse raw_* (enabled by default)
AUTO_REFRESH_ENABLED=true
MART_REFRESH_INTERVAL_MINUTES=15

# Optional: trigger Airbyte syncs via API (comma-separated connection UUIDs)
AIRBYTE_SYNC_ENABLED=false
AIRBYTE_SYNC_INTERVAL_MINUTES=15
AIRBYTE_API_URL=http://127.0.0.1:8000
AIRBYTE_USERNAME=
AIRBYTE_PASSWORD=
AIRBYTE_CONNECTION_IDS=

# Google OAuth (dashboard login; leave empty for local dev without auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
ALLOWED_EMAILS=anrewwolf68@gmail.com,danzobond@gmail.com

# Commenting as the owned accounts (YouTube / VK / Dzen)
# YouTube: OAuth with scope youtube.force-ssl (not the Airbyte readonly token).
#   python3 deploy/scripts/youtube-oauth-login.py --paste
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# VK: same user token as source-vk, plus video.createComment. For a community use negative owner_id.
VK_ACCESS_TOKEN=
VK_OWNER_ID=
VK_COMMENT_FROM_GROUP=true
# Optional: load token/owner from Airbyte source config JSON
# VK_CONFIG_PATH=/path/to/source-vk-config.json

# Dzen: Session_id cookie (+ CSRF) from a logged-in publisher session
DZEN_SESSION_ID=
DZEN_CSRF_TOKEN=

# Used only when running the app outside Docker (pip install -e .)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
